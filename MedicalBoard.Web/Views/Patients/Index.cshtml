@model List<MedicalBoard.Application.DTOs.PatientListItemDto>
@{
    ViewData["Title"] = "Patients";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Patients</h2>
    @if (User.HasClaim("permission", "Patient.Create"))
    {
        <a asp-action="Create" class="btn btn-primary">New Patient</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form method="get" class="mb-3 d-flex" style="max-width:400px;">
    <input type="text" name="term" value="@ViewData["Term"]" class="form-control me-2" placeholder="Search by name or phone" />
    <button type="submit" class="btn btn-outline-secondary">Search</button>
</form>

<table class="table table-striped">
    <thead><tr><th>Patient #</th><th>Name</th><th>Phone</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var patient in Model)
    {
        <tr>
            <td>@patient.PatientNumber</td>
            <td>@patient.FullName</td>
            <td>@patient.Phone</td>
            <td>
                @if (patient.IsActive) { <span class="badge bg-success">Active</span> }
                else { <span class="badge bg-secondary">Inactive</span> }
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@patient.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                @if (User.HasClaim("permission", "Patient.Edit"))
                {
                    <a asp-action="Edit" asp-route-id="@patient.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                }
                <form asp-action="ToggleActive" asp-route-id="@patient.Id" asp-route-isActive="@(!patient.IsActive)" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                        @(patient.IsActive ? "Deactivate" : "Activate")
                    </button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
