@model List<PatientDto>
@{
    ViewData["Title"] = "Patients";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Patients</h1>
    <a class="btn btn-primary" asp-action="Create">+ New Patient</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search by name or phone" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

<table class="table table-striped bg-white">
    <thead>
        <tr><th>Name</th><th>Patient #</th><th>Phone</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td><a asp-action="Details" asp-route-id="@p.Id">@p.FullName</a></td>
            <td>@p.PatientNumber</td>
            <td>@p.Phone</td>
            <td>
                @if (p.IsActive) { <span class="badge bg-success">Active</span> }
                else { <span class="badge bg-secondary">Inactive</span> }
            </td>
            <td class="table-actions">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@p.Id">Edit</a>
                <form method="post" asp-action="ToggleActive" asp-route-id="@p.Id">
                    <input type="hidden" name="isActive" value="@(!p.IsActive)" />
                    <button type="submit" class="btn btn-sm btn-outline-dark">@(p.IsActive ? "Deactivate" : "Activate")</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
