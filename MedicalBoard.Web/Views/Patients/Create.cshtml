@model CreatePatientDto
@{
    ViewData["Title"] = "New Patient";
}
<h1>New Patient</h1>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form method="post" class="col-md-6">
    <div class="mb-3">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="NationalIdentifier" class="form-label"></label>
        <input asp-for="NationalIdentifier" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="DateOfBirth" class="form-label"></label>
        <input asp-for="DateOfBirth" class="form-control" type="date" />
    </div>
    <div class="mb-3">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <p class="form-text">A patient number is generated automatically once saved.</p>
    <button type="submit" class="btn btn-primary">Create</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
