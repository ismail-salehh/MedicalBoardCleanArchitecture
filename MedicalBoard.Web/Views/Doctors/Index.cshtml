@model List<DoctorDto>
@{
    ViewData["Title"] = "Doctors";
    var departments = ViewBag.Departments as List<DepartmentDto> ?? new();
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Doctors</h1>
    <a class="btn btn-primary" asp-action="Create">+ New Doctor</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="departmentId" class="form-select" onchange="this.form.submit()">
            <option value="">All departments</option>
            @foreach (var d in departments)
            {
                <option value="@d.Id" selected="@((ViewBag.SelectedDepartmentId == d.Id) ? "selected" : null)">@d.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <select name="isActive" class="form-select" onchange="this.form.submit()">
            <option value="">All statuses</option>
            <option value="true" selected="@((ViewBag.SelectedIsActive == true) ? "selected" : null)">Active</option>
            <option value="false" selected="@((ViewBag.SelectedIsActive == false) ? "selected" : null)">Inactive</option>
        </select>
    </div>
</form>

<table class="table table-striped bg-white">
    <thead>
        <tr><th>Name</th><th>Employee #</th><th>Specialty</th><th>Department</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var d in Model)
    {
        <tr>
            <td><a asp-action="Details" asp-route-id="@d.Id">@d.FullName</a></td>
            <td>@d.EmployeeNumber</td>
            <td>@d.Specialty</td>
            <td>@d.DepartmentName</td>
            <td>
                @if (d.IsActive) { <span class="badge bg-success">Active</span> }
                else { <span class="badge bg-secondary">Inactive</span> }
            </td>
            <td class="table-actions">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@d.Id">Edit</a>
                <form method="post" asp-action="ToggleActive" asp-route-id="@d.Id">
                    <input type="hidden" name="isActive" value="@(!d.IsActive)" />
                    <button type="submit" class="btn btn-sm btn-outline-dark">@(d.IsActive ? "Deactivate" : "Activate")</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
