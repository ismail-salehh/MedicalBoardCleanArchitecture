@model List<MedicalBoard.Application.DTOs.DoctorListItemDto>
@{
    ViewData["Title"] = "Doctors";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Doctors</h2>
    @if (User.HasClaim("permission", "Doctor.Create"))
    {
        <a asp-action="Create" class="btn btn-primary">New Doctor</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-striped">
    <thead>
        <tr><th>Employee #</th><th>Name</th><th>Specialty</th><th>Department</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var doctor in Model)
    {
        <tr>
            <td>@doctor.EmployeeNumber</td>
            <td>@doctor.FullName</td>
            <td>@doctor.Specialty</td>
            <td>@doctor.DepartmentName</td>
            <td>
                @if (doctor.IsActive) { <span class="badge bg-success">Active</span> }
                else { <span class="badge bg-secondary">Inactive</span> }
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@doctor.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                @if (User.HasClaim("permission", "Doctor.Edit"))
                {
                    <a asp-action="Edit" asp-route-id="@doctor.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                }
                @if (User.HasClaim("permission", "Doctor.Deactivate"))
                {
                    <form asp-action="ToggleActive" asp-route-id="@doctor.Id" asp-route-isActive="@(!doctor.IsActive)" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            @(doctor.IsActive ? "Deactivate" : "Activate")
                        </button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
