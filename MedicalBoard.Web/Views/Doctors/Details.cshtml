@model DoctorDto
@{
    ViewData["Title"] = "Doctor Details";
}
<h1>@Model.FullName</h1>
<dl class="row">
    <dt class="col-sm-3">Employee #</dt><dd class="col-sm-9">@Model.EmployeeNumber</dd>
    <dt class="col-sm-3">Specialty</dt><dd class="col-sm-9">@Model.Specialty</dd>
    <dt class="col-sm-3">Department</dt><dd class="col-sm-9">@Model.DepartmentName</dd>
    <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd>
    <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>
</dl>
<a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
<a class="btn btn-link" asp-action="Index">Back to list</a>
